{
  "tenant": "larkspur",
  "about": "How Larkspur Home's own exports map onto Sinew events. Configuration, not code: confirmed by Larkspur's data owner during onboarding (ENGINE.md 2b). Unmapped coded values are held, never guessed.",
  "version": 1,
  "confirmed_by": "u-ops-head",
  "value_maps": {
    "tracking_status": {"1": "in_transit", "2": "delayed", "3": "delivered"},
    "financial_status": {"paid": "placed", "partially_refunded": "placed", "refunded": "refunded"},
    "ticket_reason": {"delay": "late_delivery", "damaged": "damaged", "wrong": "wrong_item"},
    "group_queue": {"east": "q-east", "central": "q-central"}
  },
  "sources": [
    {"name": "teams", "file": "ops.json", "path": "teams", "event": "team.upserted", "source": "roster",
     "key": "team_id", "occurred_at": {"const": "2026-05-20T00:00:00Z", "transform": "iso_to_epoch"},
     "fields": {"team_id": "team_id", "name": "name", "covers_regions": "covers_regions", "queues": "queues"}},
    {"name": "staff", "file": "ops.json", "path": "staff", "event": "staff.upserted", "source": "roster",
     "key": "user_id", "occurred_at": {"const": "2026-05-20T00:00:00Z", "transform": "iso_to_epoch"},
     "fields": {"user_id": "user_id", "team_id": "team_id", "role": "role", "refund_limit": "refund_limit",
                "reports_to": "reports_to", "display_name": "display_name"}},
    {"name": "couriers", "file": "ops.json", "path": "couriers", "event": "courier.upserted", "source": "ops",
     "key": "$value", "occurred_at": {"const": "2026-05-20T00:00:00Z", "transform": "iso_to_epoch"},
     "fields": {"courier_id": "$value"}},
    {"name": "hubs", "file": "ops.json", "path": "hubs", "event": "hub.upserted", "source": "ops",
     "key": "hub_id", "occurred_at": {"const": "2026-05-20T00:00:00Z", "transform": "iso_to_epoch"},
     "fields": {"hub_id": "hub_id", "region": "region", "courier_id": "courier_id", "capacity": "capacity"}},
    {"name": "routes", "file": "ops.json", "path": "routes", "event": "route.upserted", "source": "ops",
     "key": {"from": ["0", "1"], "join": ">"}, "occurred_at": {"const": "2026-05-20T00:00:00Z", "transform": "iso_to_epoch"},
     "fields": {"from_hub": "0", "to_hub": "1", "transit_h": "2"}},
    {"name": "catalogue", "file": "ops.json", "path": "catalogue", "event": "product.upserted", "source": "catalogue",
     "key": "sku", "occurred_at": {"const": "2026-05-20T00:00:00Z", "transform": "iso_to_epoch"},
     "fields": {"sku": "sku", "title": "title", "category": "category"}},
    {"name": "decisions", "file": "ops.json", "path": "decisions", "event": "decision.recorded", "source": "decision-log",
     "key": "decision_id", "occurred_at": {"from": "made_at", "transform": "iso_to_epoch"},
     "fields": {"decision_id": "decision_id", "title": "title", "made_at": {"from": "made_at", "transform": "iso_to_epoch"},
                "owner": "owner", "chose_kind": "chose_kind", "chose_id": "chose_id", "region": "region",
                "assumptions": "assumptions"}},

    {"name": "customers", "file": "store.json", "path": "customers", "event": "profile.upserted", "source": "store",
     "key": "id", "occurred_at": {"from": "created_at", "transform": "iso_to_epoch"},
     "fields": {"profile_id": {"from": "id", "template": "pf-ls-{}"}, "channel": {"const": "web"},
                "region": "tags", "country": "default_address.country_code",
                "since": {"from": "created_at", "transform": "iso_to_epoch"},
                "name": {"from": ["first_name", "last_name"], "join": " "}, "email": "email", "phone": "phone",
                "address": {"from": ["default_address.address1", "default_address.city"], "join": ", "}}},
    {"name": "marketing-consent", "file": "store.json", "path": "customers", "event": "consent.updated", "source": "store",
     "key": "id", "where": {"field": "accepts_marketing", "equals": true},
     "occurred_at": {"from": "created_at", "transform": "iso_to_epoch"},
     "fields": {"profile_id": {"from": "id", "template": "pf-ls-{}"}, "purpose": {"const": "marketing"},
                "granted": {"const": true}}},
    {"name": "orders", "file": "store.json", "path": "orders", "event": "order.placed", "source": "store",
     "key": "id", "where": {"field": "test", "equals": false},
     "occurred_at": {"from": "created_at", "transform": "iso_to_epoch"},
     "fields": {"order_id": {"from": "name", "transform": "strip_hash", "template": "o-{}"},
                "profile_id": {"from": "customer.id", "template": "pf-ls-{}"},
                "placed_at": {"from": "created_at", "transform": "iso_to_epoch"},
                "status": {"from": "financial_status", "map": "financial_status"}, "currency": "currency",
                "total": {"from": "total_price", "transform": "decimal"},
                "shipping_address": "shipping_address.address1",
                "lines": {"each": "line_items", "fields": {
                  "line_id": {"from": "id", "template": "l-{}"}, "sku": "sku", "qty": "quantity",
                  "price": {"from": "price", "transform": "decimal"}}}}},
    {"name": "payments", "file": "store.json", "path": "orders", "event": "payment.captured", "source": "payments",
     "key": "id", "where": {"field": "test", "equals": false},
     "occurred_at": {"from": "created_at", "transform": "iso_to_epoch", "add_seconds": 60},
     "fields": {"payment_id": {"from": "name", "transform": "strip_hash", "template": "pay-{}"},
                "order_id": {"from": "name", "transform": "strip_hash", "template": "o-{}"},
                "method": {"const": "card"}, "amount": {"from": "total_price", "transform": "decimal"}}},

    {"name": "shipments", "file": "tracking.json", "path": "", "event": "shipment.created", "source": "courier",
     "key": "tracking_number", "occurred_at": {"from": "checkpoints.0.time", "transform": "iso_to_epoch"},
     "fields": {"shipment_id": {"from": "tracking_number", "template": "sh-{}"},
                "order_id": {"from": "order_name", "transform": "strip_hash", "template": "o-{}"},
                "courier_id": "carrier",
                "promised_at": {"from": "checkpoints.0.time", "transform": "iso_to_epoch", "add_seconds": 259200}}},
    {"name": "scans", "file": "tracking.json", "path": "", "explode": "checkpoints", "event": "scan.recorded", "source": "courier",
     "key": {"from": ["$parent.tracking_number", "$index"], "join": "-"},
     "occurred_at": {"from": "time", "transform": "iso_to_epoch"},
     "fields": {"scan_id": {"from": ["$parent.tracking_number", "$index"], "join": "-"},
                "shipment_id": {"from": "$parent.tracking_number", "template": "sh-{}"},
                "hub_id": "location", "status": {"from": "status_code", "map": "tracking_status"},
                "late_hours": {"from": "delay_min", "transform": "minutes_to_hours"}}},

    {"name": "requesters", "file": "helpdesk.json", "path": "", "event": "profile.upserted", "source": "helpdesk",
     "key": "id", "occurred_at": {"from": "created_at", "transform": "iso_to_epoch"},
     "fields": {"profile_id": {"from": "requester.id", "template": "pf-hd-{}"}, "channel": "via.channel",
                "region": "group", "email": "requester.email"}},
    {"name": "tickets", "file": "helpdesk.json", "path": "", "event": "ticket.created", "source": "helpdesk",
     "key": "id", "occurred_at": {"from": "created_at", "transform": "iso_to_epoch"},
     "fields": {"ticket_id": {"from": "id", "template": "t-{}"},
                "profile_id": {"from": "requester.id", "template": "pf-hd-{}"}, "channel": "via.channel",
                "queue_id": {"from": "group", "map": "group_queue"},
                "issue_type": {"from": "custom_fields.reason", "map": "ticket_reason"},
                "order_id": {"from": "custom_fields.order_number", "transform": "strip_hash", "template": "o-{}"},
                "text": {"from": ["subject", "description"], "join": " "}}}
  ]
}
